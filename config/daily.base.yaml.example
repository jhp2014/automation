# =============================================================================
# config/daily.base.yaml — 매일 '안 바뀌는' 것들의 단일 소스(템플릿 원본).
#
# 위상:
#   - .env / daily.yaml 과 동격(git ignore). 비밀값(KWorks 비밀번호) 포함 가능.
#   - 운영자가 1회 세팅해두면, `gen-daily` 가 여기에 '그날 날짜' 만 입혀
#     config/daily.yaml 을 자동 생성한다.
#
# 사용:
#   config/daily.base.yaml.example -> config/daily.base.yaml 복사 후 채운다.
#   python -m tools.gen_daily            # 실행 시각으로 근무 자동 판정
#   python -m tools.gen_daily 21         # shift 직접 지정
#
# 날짜 규칙(gen_daily 가 처리):
#   - 운영기준일 D: 실행 시각이 다음날 06시 전이면 '전날' 로 본다.
#   - 각 값의 날짜 = D + (아래 day 오프셋). day:0=당일(D), day:1=다음날(D+1).
#   - 야간 새벽 캡처는 day:1 로 두면 자동으로 D+1 에 잡힌다.
# =============================================================================

# --- 운영자 자격증명 풀 ---
# 여러 명이 번갈아 쓰므로 각자 등록해두고, gen-daily --operator <name> 으로 선택.
operators:
  jonghun:
    user_id: ""
    user_pw: ""
  operator2:
    user_id: ""
    user_pw: ""
  operator3:
    user_id: ""
    user_pw: ""

# gen-daily 에 --operator 를 안 주면 쓰는 기본 운영자.
default_operator: jonghun

# --- 보고서 제목 템플릿 ---
# 치환자: {date}=YYYY.MM.DD, {wd}=요일(한글 1글자), {shift}=근무 label.
title_template: "{date}({wd}) {shift} OP관제 일일보고"

# --- 근무별 정의 ---
# 키(09/18/21)는 launch_windows 와 --shift 인자가 가리키는 식별자.
# run_until / server_times 의 day 는 운영기준일 D 로부터의 날짜 오프셋(0 또는 1).
shifts:
  "09":                          # 주간(09~21시)
    label: 주간
    run_until: { day: 0, time: "20:40" }     # 당일 종료
    server_times:
      - { day: 0, time: "10:15", folders: ["8 전면", "8 후면"] }
      - { day: 0, time: "14:30", folders: ["9 전면", "9 후면"] }

  "18":                          # 야간(18시 기준)
    label: 야간
    run_until: { day: 1, time: "08:40" }     # 익일 종료
    server_times:
      - { day: 0, time: "22:10", folders: ["8 전면", "8 후면"] }   # 당일 밤
      - { day: 1, time: "01:32", folders: ["9 전면", "9 후면"] }   # 다음날 새벽

  "21":                          # 야간(21시 기준) — 근무별로 다른 세트
    label: 야간
    run_until: { day: 1, time: "08:40" }
    server_times:
      - { day: 0, time: "23:40", folders: ["8 전면", "8 후면"] }
      - { day: 1, time: "04:41", folders: ["9 전면", "9 후면"] }

# --- 실행 시각 → shift 자동 매칭 ---
# gen-daily 를 인자 없이 돌리면 현재 시각이 어느 윈도우에 드는지로 shift 를 고른다.
# 윈도우 밖이면 에러 → shift 를 직접 지정(예: gen-daily 18).
launch_windows:
  - { from: "08:00", to: "10:00", shift: "09" }
  - { from: "17:00", to: "19:00", shift: "18" }
  - { from: "20:00", to: "22:00", shift: "21" }
