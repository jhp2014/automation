# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# Telegram naming convention (dynamic loading, no code changes for new jobs):
#   TELEGRAM_BOT__<JOBKEY>            = <bot_token>
#   TELEGRAM_CHAT__<JOBKEY>__<PURPOSE> = <chat_id>
#
# <JOBKEY> and <PURPOSE> are case-insensitive (normalized to UPPER internally).
# Add a new job by adding two lines here; no code change required.
# =============================================================================

# --- Pushover (single account, used for emergency alerts) ---
PUSHOVER_TOKEN=        # Pushover application token
PUSHOVER_USER=         # Pushover user/group key

# --- Telegram: Zenius job ---
TELEGRAM_BOT__ZENIUS=                 # Telegram bot token for the Zenius job
TELEGRAM_CHAT__ZENIUS__REPORT=        # Chat id for Zenius report messages
TELEGRAM_CHAT__ZENIUS__HEARTBEAT=     # Chat id for Zenius heartbeat messages

# --- Telegram: DailyService job ---
TELEGRAM_BOT__DAILYSERVICE=               # Telegram bot token for the DailyService job
TELEGRAM_CHAT__DAILYSERVICE__HEARTBEAT=   # Chat id for DailyService heartbeat messages

# --- Job login credentials ---
ZENIUS_USER_ID=          # Zenius EMS login id
ZENIUS_USER_PW=          # Zenius EMS login password
DAILYSERVICE_USER_ID=    # SDS DailyService login id
DAILYSERVICE_USER_PW=    # SDS DailyService login password

# --- KWorks login (shared by jobs.server and jobs.capture) ---
KWORKS_USER_ID=          # KWorks login id (server·capture 공용)
KWORKS_USER_PW=          # KWorks login password (server·capture 공용)
